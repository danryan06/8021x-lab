# 802.1X Lab — copy to .env and adjust as needed
# Lab / education use only. Not hardened for production.

COMPOSE_PROJECT_NAME=dot1x-lab

# PostgreSQL
POSTGRES_USER=dot1x
POSTGRES_PASSWORD=dot1x_lab_change_me
POSTGRES_DB=dot1x_lab
DATABASE_URL=postgresql+psycopg://dot1x:dot1x_lab_change_me@db:5432/dot1x_lab

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# FreeRADIUS integration
FREERADIUS_CONFIG_DIR=/var/lib/dot1x-lab/freeradius
FREERADIUS_AUTH_LOG_PATH=/var/lib/dot1x-lab/freeradius/logs/auth.log
# Optional extra reload hook; primary mechanism is the shared-volume
# restart.request / reload.request flags handled by the FreeRADIUS entrypoint.
FREERADIUS_RELOAD_COMMAND=echo "reload-requested"
# In-Compose eapol_test target (backend → freeradius). This single value is
# passed to both the backend and the FreeRADIUS entrypoint catch-all clients.
FREERADIUS_HOST=freeradius
FREERADIUS_AUTH_PORT=1812
FREERADIUS_LAB_SECRET=testing123
FREERADIUS_CA_PATH=/var/lib/dot1x-lab/freeradius/certs/ca.pem
CA_DATA_DIR=/var/lib/dot1x-lab/ca
CA_ADAPTER=openssl

# Advertised RADIUS target for real NAS/AP devices (DHCP/host IP).
# Leave empty for UI Auto mode + bootstrap detection; or set manually (e.g. 10.0.0.50).
RADIUS_ADVERTISE_IP=
RADIUS_ADVERTISE_AUTH_PORT=1812
RADIUS_ADVERTISE_ACCT_PORT=1813

# Frontend (build-time)
VITE_API_BASE_URL=/api
